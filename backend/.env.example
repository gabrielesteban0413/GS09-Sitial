APP_NAME=Sitial
APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
GOOGLE_MAPS_API_KEY=replace-with-google-maps-key
GOOGLE_MAPS_TIMEOUT=10
GOOGLE_MAPS_CACHE_TTL=3600
DATABASE_URL=postgresql+asyncpg://sitial:password@postgres:5432/sitial
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_ANONYMOUS=20/minute
RATE_LIMIT_AUTHENTICATED=200/minute
LOG_LEVEL=INFO
LOG_FORMAT=json
